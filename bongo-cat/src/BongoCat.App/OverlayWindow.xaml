<Window x:Class="BongoCat.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bongo Cat"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid>
        <Viewbox Stretch="Uniform">
        <Canvas x:Name="Stage" Width="960" Height="640">
            <Image x:Name="BodyImage" Stretch="Fill" />
            <Image x:Name="MouthImage" Stretch="Fill" />
            <Image x:Name="EyesImage" Stretch="Fill" />
            <Image x:Name="BangsImage" Stretch="Fill" />
            <Image x:Name="MouseImage" Stretch="Fill" />
            <Image x:Name="HandImage" Stretch="Fill" />
            <Canvas x:Name="Guides" />
            <Border x:Name="EmptyHint"
                    Canvas.Left="24"
                    Canvas.Top="24"
                    Background="#CC111111"
                    CornerRadius="8"
                    Padding="12"
                    Visibility="Collapsed">
                <TextBlock Foreground="White"
                           FontSize="18"
                           Text="Положите PNG в папку assets рядом с программой" />
            </Border>
        </Canvas>
        </Viewbox>
        <Border x:Name="ResizeThumb"
                Width="22"
                Height="22"
                Margin="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#CCFFFFFF"
                BorderBrush="#FF333333"
                BorderThickness="1"
                CornerRadius="4"
                Cursor="SizeNWSE"
                ToolTip="Тяните, чтобы изменить размер"
                Visibility="Collapsed"
                MouseLeftButtonDown="ResizeThumb_OnMouseLeftButtonDown"
                MouseLeftButtonUp="ResizeThumb_OnMouseLeftButtonUp"
                MouseMove="ResizeThumb_OnMouseMove" />
    </Grid>
</Window>
